{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar (projeto - vários arquivos)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/compilar-projeto.ps1",
                "-Pasta",
                "${fileDirname}",
                "-Saida",
                "${fileDirname}/${fileDirnameBasename}.exe"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Compila todos os .c da pasta do arquivo aberto (não executa). Usada como preLaunchTask do debug."
        },
        {
            "label": "Compilar e Executar (projeto - vários arquivos)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/compilar-projeto.ps1",
                "-Pasta",
                "${fileDirname}",
                "-Saida",
                "${fileDirname}/${fileDirnameBasename}.exe",
                "-Executar"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Atalho padrão: Ctrl+Shift+B. Compila todos os .c da pasta e executa o programa."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}